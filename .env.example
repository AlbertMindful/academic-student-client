# ============================================================
# 教务助手 · 环境变量示例
# 复制为 .env.local 后按需修改。切勿提交任何真实凭据。
# ============================================================

# 数据源：mock（前端开发演示，任意账号密码可登录）| real（真实登录）
ACADEMIC_DATA_SOURCE=mock

# 登录保持时间（毫秒），默认 30 天
ACADEMIC_SESSION_TTL_MS=2592000000

# 密码静默续登与学习通连接的保持时间（默认 180 天，每次使用会自动延长）
ACADEMIC_CREDENTIAL_TTL_MS=15552000000
CHAOXING_SESSION_TTL_MS=15552000000

# 生产环境必须设置至少 32 位随机值，用于加密持久化登录会话
ACADEMIC_SESSION_SECRET=请替换为至少32位随机字符串

# 可选：Neon PostgreSQL 连接地址，用于跨设备同步完成/已读/忽略/置顶状态
# 数据库只保存哈希化账号归属、事件 id 与本地处理状态，不保存平台凭据
DATABASE_URL=postgresql://用户名:密码@主机/数据库?sslmode=require

# 教务系统（jw）与统一身份认证（SSO）基础地址（默认值已内置，通常无需修改）
ACADEMIC_JW_BASE_URL=https://jw.cquet.edu.cn
ACADEMIC_SSO_BASE_URL=https://sso.cquet.edu.cn

# SSO 密码登录接口路径
ACADEMIC_SSO_LOGIN_PATH=/uaa/login_process

# 短信登录相关路径（学校 SSO 升级后可在此调整）
ACADEMIC_SSO_SMS_SEND_PATH=/oauthv2/sms/getCodeByUser
ACADEMIC_SSO_DEVICE_CODE_PATH=/validata/deviceCode/{deviceId}
ACADEMIC_SSO_VERIFICATION_PATH=/verificationCode

# OAuth 客户端 id（由 jw 转发到 SSO authorize 时使用）
ACADEMIC_OAUTH_CLIENT_ID=jw-legal-web

# SSO 登录页公开 JS 中的客户端 AES 密钥（复现官方网页加密，通常无需修改）
ACADEMIC_SSO_AES_KEY=mlGrb9XRQvSMyO1p

# 个人云盘。默认总容量 8GB、单文件 200MB，并始终为系统保留至少 8GB。
DRIVE_STORAGE_PATH=/var/lib/academic-student-drive
DRIVE_QUOTA_BYTES=8589934592
DRIVE_RESERVE_BYTES=8589934592
DRIVE_MAX_FILE_BYTES=209715200
